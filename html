<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CyberCore - Mod & Injector Control Panel</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            cyber: {
              black: '#0a0d14',
              darker: '#111622',
              card: '#182030',
              border: '#2a364f',
              neon: '#00f0ff',
              green: '#00ff66',
              red: '#ff0055',
              purple: '#9d00ff',
              yellow: '#ffaa00'
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['Fira Code', 'monospace']
          }
        }
      }
    }
  </script>
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    body {
      background-color: #0a0d14;
      font-family: 'Inter', sans-serif;
      color: #e2e8f0;
    }
    .neon-border {
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
    }
    .neon-text-cyan {
      text-shadow: 0 0 8px rgba(0, 240, 255, 0.6);
    }
    .neon-text-green {
      text-shadow: 0 0 8px rgba(0, 255, 102, 0.6);
    }
    .neon-text-red {
      text-shadow: 0 0 8px rgba(255, 0, 85, 0.6);
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0a0d14;
    }
    ::-webkit-scrollbar-thumb {
      background: #2a364f;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #00f0ff;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col md:flex-row overflow-x-hidden">

  <!-- Mobile Top Bar -->
  <div class="md:hidden bg-cyber-darker border-b border-cyber-border p-4 flex justify-between items-center z-50">
    <div class="flex items-center gap-2">
      <i class="fa-solid fa-shield-halved text-cyber-neon text-xl"></i>
      <span class="font-extrabold text-lg tracking-wider text-white">CYBER<span class="text-cyber-neon">CORE</span></span>
    </div>
    <button id="mobileMenuBtn" class="text-gray-300 hover:text-white text-xl">
      <i class="fa-solid fa-bars"></i>
    </button>
  </div>

  <!-- Sidebar -->
  <aside id="sidebar" class="fixed md:static inset-y-0 left-0 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out w-64 bg-cyber-darker border-r border-cyber-border flex flex-col z-40">
    <div class="p-5 hidden md:flex items-center gap-3 border-b border-cyber-border">
      <div class="w-10 h-10 rounded-lg bg-cyber-neon/10 border border-cyber-neon flex items-center justify-center text-cyber-neon text-xl shadow-[0_0_15px_rgba(0,240,255,0.3)]">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <div>
        <h1 class="font-black text-lg tracking-wider text-white">CYBER<span class="text-cyber-neon">CORE</span></h1>
        <p class="text-xs text-gray-400">Injector Admin v2.4</p>
      </div>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex-1 p-4 space-y-1.5 overflow-y-auto">
      <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-cyber-neon bg-cyber-neon/10 border border-cyber-neon/30">
        <i class="fa-solid fa-chart-pie w-5"></i> Dashboard
      </button>

      <button onclick="switchTab('keys')" id="nav-keys" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:bg-cyber-card hover:text-white transition-all">
        <i class="fa-solid fa-key w-5"></i> License Keys
      </button>

      <button onclick="switchTab('mods')" id="nav-mods" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:bg-cyber-card hover:text-white transition-all">
        <i class="fa-solid fa-cubes w-5"></i> Mod & Injector Status
      </button>

      <button onclick="switchTab('bans')" id="nav-bans" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:bg-cyber-card hover:text-white transition-all">
        <i class="fa-solid fa-user-slash w-5"></i> HWID & User Bans
      </button>

      <button onclick="switchTab('api')" id="nav-api" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:bg-cyber-card hover:text-white transition-all">
        <i class="fa-solid fa-terminal w-5"></i> Live API Simulator
      </button>

      <button onclick="switchTab('announcements')" id="nav-announcements" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:bg-cyber-card hover:text-white transition-all">
        <i class="fa-solid fa-bullhorn w-5"></i> In-App Notice Center
      </button>
    </nav>

    <!-- Server Status Widget -->
    <div class="p-4 border-t border-cyber-border m-3 bg-cyber-card/60 rounded-xl">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold uppercase text-gray-400">Server Health</span>
        <span id="serverStatusBadge" class="inline-flex items-center gap-1.5 text-xs font-bold text-cyber-green">
          <span class="w-2 h-2 rounded-full bg-cyber-green animate-pulse"></span> ONLINE
        </span>
      </div>
      <div class="w-full bg-cyber-black rounded-full h-1.5 mb-3 overflow-hidden">
        <div class="bg-cyber-neon h-1.5 rounded-full" style="width: 98%"></div>
      </div>
      <button onclick="toggleServerStatus()" class="w-full text-xs bg-cyber-border hover:bg-cyber-border/80 text-gray-300 py-1.5 rounded-lg transition font-medium">
        Toggle Maintenance Mode
      </button>
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="flex-1 p-4 md:p-8 overflow-y-auto max-w-7xl mx-auto w-full">

    <!-- Toast Notifications Container -->
    <div id="toastContainer" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- ================= DASHBOARD TAB ================= -->
    <section id="tab-dashboard" class="tab-content space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-wide">System Dashboard</h2>
          <p class="text-sm text-gray-400">Real-time overview of active licenses, injector connections, and security status.</p>
        </div>
        <button onclick="openCreateKeyModal()" class="inline-flex items-center justify-center gap-2 bg-cyber-neon text-cyber-black font-semibold px-4 py-2.5 rounded-xl hover:bg-cyan-300 transition shadow-[0_0_15px_rgba(0,240,255,0.4)]">
          <i class="fa-solid fa-plus"></i> Generate License Key
        </button>
      </div>

      <!-- Metrics Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-cyber-card border border-cyber-border p-5 rounded-2xl relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Total Registered Keys</p>
              <h3 id="statTotalKeys" class="text-3xl font-extrabold text-white mt-1">0</h3>
            </div>
            <div class="p-3 bg-cyber-neon/10 rounded-xl text-cyber-neon border border-cyber-neon/20">
              <i class="fa-solid fa-key text-xl"></i>
            </div>
          </div>
          <p class="text-xs text-cyber-neon mt-3"><i class="fa-solid fa-arrow-up"></i> Live Database Counter</p>
        </div>

        <div class="bg-cyber-card border border-cyber-border p-5 rounded-2xl relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Active Valid Keys</p>
              <h3 id="statActiveKeys" class="text-3xl font-extrabold text-cyber-green mt-1">0</h3>
            </div>
            <div class="p-3 bg-cyber-green/10 rounded-xl text-cyber-green border border-cyber-green/20">
              <i class="fa-solid fa-circle-check text-xl"></i>
            </div>
          </div>
          <p class="text-xs text-cyber-green mt-3"><i class="fa-solid fa-shield"></i> Unexpired & Valid</p>
        </div>

        <div class="bg-cyber-card border border-cyber-border p-5 rounded-2xl relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Banned Users/HWID</p>
              <h3 id="statBannedUsers" class="text-3xl font-extrabold text-cyber-red mt-1">0</h3>
            </div>
            <div class="p-3 bg-cyber-red/10 rounded-xl text-cyber-red border border-cyber-red/20">
              <i class="fa-solid fa-user-lock text-xl"></i>
            </div>
          </div>
          <p class="text-xs text-cyber-red mt-3"><i class="fa-solid fa-ban"></i> Access Blocked</p>
        </div>

        <div class="bg-cyber-card border border-cyber-border p-5 rounded-2xl relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Active Loaders Online</p>
              <h3 id="statLiveConnections" class="text-3xl font-extrabold text-cyber-purple mt-1">24</h3>
            </div>
            <div class="p-3 bg-cyber-purple/10 rounded-xl text-cyber-purple border border-cyber-purple/20">
              <i class="fa-solid fa-network-wired text-xl"></i>
            </div>
          </div>
          <p class="text-xs text-cyber-purple mt-3"><i class="fa-solid fa-wifi"></i> Live Connected Clients</p>
        </div>
      </div>

      <!-- Quick Status & Recent Keys Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Recent Generated Keys Table -->
        <div class="lg:col-span-2 bg-cyber-card border border-cyber-border rounded-2xl p-5">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-white">Recent License Keys</h3>
            <button onclick="switchTab('keys')" class="text-xs text-cyber-neon hover:underline font-semibold">View All Keys &rarr;</button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="text-xs text-gray-400 uppercase border-b border-cyber-border bg-cyber-darker/50">
                <tr>
                  <th class="py-3 px-3">License Key</th>
                  <th class="py-3 px-3">Duration</th>
                  <th class="py-3 px-3">HWID Lock</th>
                  <th class="py-3 px-3">Status</th>
                </tr>
              </thead>
              <tbody id="recentKeysTable" class="divide-y divide-cyber-border/50">
                <!-- Javascript populated -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- System Activity Log -->
        <div class="bg-cyber-card border border-cyber-border rounded-2xl p-5 flex flex-col">
          <h3 class="text-lg font-bold text-white mb-3">Live System Activity</h3>
          <div id="activityLogs" class="flex-1 space-y-3 font-mono text-xs overflow-y-auto max-h-[300px] pr-1">
            <!-- Dynamic logs -->
          </div>
        </div>
      </div>
    </section>

    <!-- ================= LICENSE KEYS TAB ================= -->
    <section id="tab-keys" class="tab-content hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-wide">License Key Management</h2>
          <p class="text-sm text-gray-400">Generate, track, bind HWID, or revoke injector access keys.</p>
        </div>
        <button onclick="openCreateKeyModal()" class="bg-cyber-neon text-cyber-black font-semibold px-4 py-2.5 rounded-xl hover:bg-cyan-300 transition shadow-[0_0_15px_rgba(0,240,255,0.4)] flex items-center justify-center gap-2">
          <i class="fa-solid fa-key"></i> Bulk / Single Key Generator
        </button>
      </div>

      <!-- Filters & Search Bar -->
      <div class="bg-cyber-card border border-cyber-border p-4 rounded-2xl flex flex-col md:flex-row gap-3 justify-between items-center">
        <div class="relative w-full md:w-80">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-gray-400 text-sm"></i>
          <input type="text" id="keySearchInput" onkeyup="filterKeys()" placeholder="Search Key or HWID..." class="w-full bg-cyber-darker border border-cyber-border rounded-xl pl-10 pr-4 py-2 text-sm text-white focus:outline-none focus:border-cyber-neon">
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
          <select id="keyStatusFilter" onchange="filterKeys()" class="bg-cyber-darker border border-cyber-border text-xs rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyber-neon">
            <option value="ALL">All Statuses</option>
            <option value="ACTIVE">Active Keys</option>
            <option value="EXPIRED">Expired Keys</option>
            <option value="BANNED">Banned Keys</option>
          </select>
          <select id="keyDurationFilter" onchange="filterKeys()" class="bg-cyber-darker border border-cyber-border text-xs rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyber-neon">
            <option value="ALL">All Durations</option>
            <option value="1 Day">1 Day</option>
            <option value="7 Days">7 Days</option>
            <option value="30 Days">30 Days</option>
            <option value="Lifetime">Lifetime</option>
          </select>
        </div>
      </div>

      <!-- Keys Table -->
      <div class="bg-cyber-card border border-cyber-border rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="text-xs text-gray-400 uppercase border-b border-cyber-border bg-cyber-darker">
              <tr>
                <th class="py-3.5 px-4">Key</th>
                <th class="py-3.5 px-4">Duration</th>
                <th class="py-3.5 px-4">HWID Binding</th>
                <th class="py-3.5 px-4">Expires At</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="allKeysTable" class="divide-y divide-cyber-border/50">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ================= MOD STATUS TAB ================= -->
    <section id="tab-mods" class="tab-content hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-wide">Mod & Injector Status Control</h2>
          <p class="text-sm text-gray-400">Control real-time availability, update triggers, and version numbers for client loaders.</p>
        </div>
        <button onclick="openAddModModal()" class="bg-cyber-neon text-cyber-black font-semibold px-4 py-2.5 rounded-xl hover:bg-cyan-300 transition shadow-[0_0_15px_rgba(0,240,255,0.4)] flex items-center justify-center gap-2">
          <i class="fa-solid fa-plus-circle"></i> Add Game Mod Target
        </button>
      </div>

      <!-- Mods Grid -->
      <div id="modsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Dynamically Populated Mods -->
      </div>
    </section>

    <!-- ================= BAN LIST TAB ================= -->
    <section id="tab-bans" class="tab-content hidden space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-wide">HWID & User Ban Management</h2>
        <p class="text-sm text-gray-400">Manage blacklisted hardware signatures, IP logs, and security violations.</p>
      </div>

      <!-- Quick Ban Box -->
      <div class="bg-cyber-card border border-cyber-border p-5 rounded-2xl">
        <h3 class="text-base font-bold text-white mb-3">Instant HWID / Key Ban Trigger</h3>
        <form id="quickBanForm" onsubmit="handleQuickBan(event)" class="flex flex-col sm:flex-row gap-3">
          <input type="text" id="banTargetInput" placeholder="Enter License Key or Hardware ID (HWID)..." required class="flex-1 bg-cyber-darker border border-cyber-border rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-cyber-red">
          <input type="text" id="banReasonInput" placeholder="Reason (e.g. Memory Sniffing, Key Sharing)..." required class="flex-1 bg-cyber-darker border border-cyber-border rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-cyber-red">
          <button type="submit" class="bg-cyber-red text-white font-semibold px-6 py-2.5 rounded-xl hover:bg-red-600 transition shadow-[0_0_15px_rgba(255,0,85,0.4)] flex items-center justify-center gap-2">
            <i class="fa-solid fa-gavel"></i> Apply Instant Ban
          </button>
        </form>
      </div>

      <!-- Ban Table -->
      <div class="bg-cyber-card border border-cyber-border rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="text-xs text-gray-400 uppercase border-b border-cyber-border bg-cyber-darker">
              <tr>
                <th class="py-3.5 px-4">Banned Target (Key/HWID)</th>
                <th class="py-3.5 px-4">Reason</th>
                <th class="py-3.5 px-4">Ban Date</th>
                <th class="py-3.5 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="banListTable" class="divide-y divide-cyber-border/50">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ================= LIVE API SIMULATOR TAB ================= -->
    <section id="tab-api" class="tab-content hidden space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-wide">Live Loader API Request Simulator</h2>
        <p class="text-sm text-gray-400">Test how C++, C#, or Android injector clients communicate with this backend panel.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- API Client Request Simulator Form -->
        <div class="bg-cyber-card border border-cyber-border p-5 rounded-2xl space-y-4">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-terminal text-cyber-neon"></i> Client Request Sandbox
          </h3>

          <div>
            <label class="block text-xs font-semibold text-gray-400 uppercase mb-1">Select Endpoint</label>
            <select id="apiEndpointSelect" class="w-full bg-cyber-darker border border-cyber-border rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-cyber-neon">
              <option value="/api/v1/authenticate">POST /api/v1/authenticate (License Key + HWID Check)</option>
              <option value="/api/v1/mod-status">GET /api/v1/mod-status (Query Game Mod Statuses)</option>
       
